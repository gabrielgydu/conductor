#!/bin/bash
# Auto-bootstrapping wrapper for runner.
# Creates venv and installs deps on first run — no manual setup needed.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"

if [[ ! -d "$VENV_DIR" ]]; then
    echo "First run — setting up Python environment..."
    python -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install -q -e "$SCRIPT_DIR[dev]"
    echo "Done."
fi

exec "$VENV_DIR/bin/python" -m runner "$@"
